# 指向這台伺服器的公開 DNS 網域，例如 sync.example.com。
SYNC_DOMAIN=sync.example.com

# 請產生至少 16 字元的隨機值，僅在配對裝置時使用。
PAIR_CODE=replace-with-a-long-random-secret

# LINE 主動提醒為選用功能。請勿將實際值提交到 Git。
# LINE_CHANNEL_ACCESS_TOKEN 從 LINE Developers Console 產生；LINE_USER_ID 是
# 你自己的 LINE 使用者 ID。兩者都留白時，不會發送 LINE 通知。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# 提醒使用台灣時區。每日摘要包含今日課程與今日／明日到期事項；到期提醒
# 預設會在到期前 3、1、0 天的指定時間發送。
REMINDER_TIMEZONE=Asia/Taipei
LINE_DAILY_SUMMARY_TIME=07:00
LINE_DUE_REMINDER_TIME=09:00
LINE_DUE_REMINDER_DAYS=3,1,0
REMINDER_CHECK_INTERVAL=5m
